# Remote server — point the CLI/MCP at a shared RAG server (see docker-compose.yml).
# Leave RAG_SERVER_URL unset for local mode (uses the local sqlite file directly;
# every command prints a one-line "local mode" notice to stderr). When set, the
# server owns the database + embedder and embeds your query text server-side.
# Run `rag init` to generate a documented ~/.rag/config.env interactively.
# RAG_SERVER_URL=http://rag.internal:8080
# RAG_SERVER_TOKEN=        # legacy alias for RAG_SERVER_READ_TOKEN below
# RAG_SERVER_READ_TOKEN=   # shared read token; unset = open mode (trusted-LAN dev)
# RAG_SERVER_TOKEN_FILE=   # path to a mounted secret file; overrides the token above
# RAG_SERVER_CORS_ORIGINS= # comma-separated browser origin allowlist; never use * with credentials
# RAG_SERVER_TIMEOUT=120   # seconds; ingest embeds server-side and can be slow

# MCP over HTTP — the server hosts the MCP tools at /mcp/<project_id>, so a
# client needs only that URL and a read token (no local rag-mcp process).
# RAG_SERVER_MCP_ENABLED=true  # false = serve the plain REST API only
# RAG_MCP_ALLOWED_HOSTS=       # Host allowlist for /mcp (DNS-rebinding protection);
#                              # exact or port-wildcarded ("rag.internal:*"), no "*"
#                              # catch-all. Unset = check disabled.
# RAG_MCP_ALLOWED_ORIGINS=     # browser Origin allowlist for /mcp; only read when
#                              # RAG_MCP_ALLOWED_HOSTS is set

# AWS Configuration
AWS_REGION=eu-west-1
AWS_PROFILE=default

# Model backends — per capability, each "local" (DEFAULT) or "bedrock".
# embedding / text / vision are independent so you can mix. The recommended
# setup on a consumer GPU is the HYBRID below: local embeddings + text, but
# Bedrock for vision (local 7-8B VLMs trail Claude on complex diagrams, and
# Bedrock vision is ~$1-2 one-time for a whole corpus).
#   The "local" runtimes require:  pip install 'datasheet-rag[local,local-hf]'
#   NOTE: switching RAG_EMBEDDING_BACKEND makes existing stored vectors
#   incompatible — re-embed the corpus on a DB created with the matching
#   RAG_EMBEDDING_DIMENSIONS (vectors from different models aren't comparable).
RAG_EMBEDDING_BACKEND=local    # search hot path: faster (no RTT), offline, parity
RAG_TEXT_BACKEND=bedrock       # titling, summaries — slightly better on Haiku, ~free
RAG_VISION_BACKEND=bedrock     # figure descriptions, table repair (above 12GB-local VLMs) (hybrid)

# Local runtimes — "huggingface" (in-process PyTorch/CUDA) or "ollama".
# RAG_OLLAMA_HOST=http://localhost:11434

# Embeddings: huggingface = sentence-transformers (robust; only reliable way to
# run bge-m3). 'ollama' works too but use mxbai-embed-large, NOT bge-m3 (NaN bug).
RAG_LOCAL_EMBEDDING_RUNTIME=huggingface
RAG_LOCAL_EMBEDDING_MODEL=BAAI/bge-m3   # HF repo id; ollama tag if runtime=ollama

# Text LLM: ollama (light) or huggingface (in-process causal LM).
RAG_LOCAL_TEXT_RUNTIME=ollama
RAG_LOCAL_TEXT_MODEL=qwen2.5:7b         # ollama tag; HF repo id if runtime=huggingface

# Vision LLM (only used if RAG_VISION_BACKEND=local): huggingface gives precise
# VRAM control for VLMs. ...-3B fits 12GB; ...-7B/-32B/-72B need more VRAM.
RAG_LOCAL_VISION_RUNTIME=huggingface
RAG_LOCAL_VISION_MODEL=Qwen/Qwen2.5-VL-3B-Instruct  # HF repo id; ollama tag if runtime=ollama
# RAG_LOCAL_HF_LOAD_4BIT=false           # 4-bit (bitsandbytes) to fit 7B+ on small VRAM

# S3
RAG_S3_BUCKET=my-rag-datasheets

# Textract
RAG_TEXTRACT_ROLE_ARN=arn:aws:iam::123456789012:role/TextractRole

# Embedding (Bedrock)
RAG_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_NORMALIZE=true
RAG_EMBEDDING_BATCH_SIZE=16

# Docling table-structure recognition: "fast" (default, ~2.4x faster) or
# "accurate" (slower, more precise cell boundaries — but NOT a guaranteed
# fix for complex misparsed/garbled headers). Override per-ingest with
# `rag ingest --accurate-tables` / `--fast-tables`. See README → Global
# config options → Table parsing mode.
RAG_TABLE_STRUCTURE_MODE=fast

# Figure description (Bedrock Claude vision)
RAG_DESCRIPTION_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
RAG_DESCRIPTION_MAX_TOKENS=400
RAG_DESCRIPTION_CONCURRENCY=4

# Table-structure repair (Bedrock Claude vision — `rag repair-tables`).
# Recommended: a Sonnet inference-profile ARN for your account/region (stronger
# structural reasoning than the Haiku used for figure descriptions above).
# Falls back to RAG_DESCRIPTION_MODEL_ID if unset (not recommended for production).
# RAG_TABLE_REPAIR_MODEL_ID=
# RAG_TABLE_REPAIR_MAX_TOKENS=4000
# RAG_TABLE_REPAIR_CONCURRENCY=2

# SQLite store — defaults to <rag_home>/rag.sqlite (~/.rag/rag.sqlite); override
# with --db / RAG_SQLITE_DB_PATH for tests or intentionally-isolated databases.
# RAG_SQLITE_DB_PATH=

# MCP server — set per-project in the Claude Code .mcp.json
# RAG_DEFAULT_PROJECT_ID=pcb-rev-a

# Optional: override endpoints for local development
# AWS_ENDPOINT_URL=http://localhost:4566
